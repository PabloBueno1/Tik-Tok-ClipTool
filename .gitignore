!content-pipeline/inputs/**/.gitkeep
content-pipeline/outputs/**
!content-pipeline/outputs/**/
!content-pipeline/outputs/**/.gitkeep
content-pipeline/data/**
!content-pipeline/data/**/
!content-pipeline/data/**/.gitkeep
